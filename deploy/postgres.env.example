# Settings of compose.postgres.yaml. Copy to `.env` next to the compose file and fill in.
# Never commit the filled-in file.

# Public host name. Caddy obtains a certificate for it (ports 80 and 443 must reach this host).
AGENTLENS_DOMAIN=agentlens.example.com
# `auto` (ACME) or `internal` (Caddy's own CA, for private networks).
AGENTLENS_TLS=auto

# PostgreSQL password of the `agentlens` role. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# UI login (auth.mode=password): user `admin` with this password (required; app refuses to start
# without one). For auth.mode=proxy, configure a `forward_auth` login step in deploy/Caddyfile
# first (see the comment there): Caddy drops client-sent identity headers by default.
AGENTLENS_AUTH_MODE=password
AGENTLENS_ADMIN_PASSWORD=
AGENTLENS_TRUSTED_PROXIES=

# The API key of Project "default" is generated by `app` on first start:
#   docker compose -f compose.postgres.yaml exec app cat /data/bootstrap-api-key

# Optional: publish Caddy on other host ports. Then set AGENTLENS_PUBLIC_URL to the URL users
# open (for example https://agentlens.example.com:8443), so the UI connects back to it.
# AGENTLENS_HTTP_PORT=80
# AGENTLENS_HTTPS_PORT=443
# AGENTLENS_GRPC_PORT=4317
# AGENTLENS_PUBLIC_URL=
